{
  "manifest_version": 3,
  "name": "xClick",
  "short_name": "xClick",
  "version": "0.5.0",
  "description": "Local interaction effects and optional AI-assisted English or Chinese reply drafts for X.",
  "homepage_url": "https://github.com/mCapricorn/xClick",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage"],
  "options_ui": { "page": "ai/settings.html", "open_in_tab": true },
  "background": { "service_worker": "ai/background.mjs", "type": "module" },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["sound.js", "content.js", "ai/reaction-gif.js", "ai/media-actions.js", "ai/composer.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "xClick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
